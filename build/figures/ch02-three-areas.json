  "cards": [
    {
      "dot": "emerald",
      "title": "三区的意义",
      "items": [
        "工作目录：你看到的文件",
        "暂存区：下一次 commit 的预览（精细控制）",
        "仓库：历史珠子档案",
        "三区分开 = 你能选择「哪些改动放进这次 commit」"
      ]
    },
    {
      "dot": "rose",
      "title": "常见坑",
      "items": [
        "git add . 之前想清楚（这会推进所有修改）",
        "git reset --hard 会清掉工作目录未提交改动（reflog 还能救）",
        "commit 后只能通过新 commit 来补救（不修改历史）"
      ]
    },
    {
      "dot": "cyan",
      "title": "五条命令：谁把数据推到哪一层",
      "items": [
        "git add <file> — 把工作目录的当前内容加入暂存区",
        "git commit — 把暂存区内容造一颗珠子落进仓库",
        "git checkout / restore — 从仓库读出某个版本到工作目录",
        "git reset --soft — 回退 HEAD → 暂存区（不改工作目录）",
        "git reset --hard — 回退 HEAD + 暂存区 + 工作目录（小心！）"
      ]
    }
  ]
}